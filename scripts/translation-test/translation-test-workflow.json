{
  "name": "translation-test",
  "description": "Test workflow for translations: TERMINATE resolves the message in the caller's language (no Respond task)",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "example@email.com",
  "restartable": true,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 0,
  "inputParameters": [
    "outcome",
    "customerName",
    "orderId",
    "_language"
  ],
  "tasks": [
    {
      "name": "route",
      "taskReferenceName": "route_ref",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "outcome",
      "inputParameters": {
        "outcome": "${workflow.input.outcome}"
      },
      "decisionCases": {
        "failure": [
          {
            "name": "terminate",
            "taskReferenceName": "end_failed_ref",
            "type": "TERMINATE",
            "inputParameters": {
              "terminationStatus": "FAILED",
              "messageCode": "PAYMENT_DECLINED",
              "workflowOutput": {
                "orderId": "${workflow.input.orderId}"
              }
            }
          }
        ]
      },
      "defaultCase": [
        {
          "name": "terminate",
          "taskReferenceName": "end_ok_ref",
          "type": "TERMINATE",
          "inputParameters": {
            "terminationStatus": "COMPLETED",
            "messageCode": "${workflow.input.messageCode}",
            "variables": {
              "orderId": "${workflow.input.orderId}"
            },
            "workflowOutput": {
              "orderId": "${workflow.input.orderId}"
            }
          }
        }
      ]
    }
  ],
  "outputParameters": {},
  "metadata": {
    "defaultLanguage": "en-US",
    "supportedLanguages": [
      "en-US",
      "ar-EG"
    ]
  }
}
