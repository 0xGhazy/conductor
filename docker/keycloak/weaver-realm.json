{
  "realm": "weaver",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "conductor_admin",
        "description": "Conductor Administrator with full access"
      },
      {
        "name": "conductor_operator",
        "description": "Conductor Operator with execution and workflow definition management access"
      },
      {
        "name": "conductor_viewer",
        "description": "Conductor Viewer with read-only access"
      },
      {
        "name": "conductor_worker",
        "description": "Conductor Worker for polling and updating tasks"
      }
    ]
  },
  "clients": [
    {
      "clientId": "weaver",
      "name": "Weaver Client (Public / UI / CLI)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "web-origins",
        "role_list",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "weaver-worker",
      "name": "Weaver Worker Service Account (SDK / Microservices)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "conductor-worker-secret-12345",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "role_list",
        "profile",
        "roles",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@conductor.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Conductor",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "conductor_admin",
        "conductor_operator",
        "conductor_viewer"
      ]
    },
    {
      "username": "operator",
      "email": "operator@conductor.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Conductor",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "conductor_operator",
        "conductor_viewer"
      ]
    },
    {
      "username": "viewer",
      "email": "viewer@conductor.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Conductor",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "conductor_viewer"
      ]
    },
    {
      "username": "service-account-weaver-worker",
      "enabled": true,
      "serviceAccountClientId": "weaver-worker",
      "realmRoles": [
        "conductor_worker"
      ]
    }
  ]
}
