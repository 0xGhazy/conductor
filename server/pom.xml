<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vodafone.vss.weaver</groupId>
        <artifactId>weaver</artifactId>
        <version>3.30.2-SNAPSHOT</version>
    </parent>

    <artifactId>weaver-server</artifactId>
    <name>weaver-server</name>
    <description>Server boot application for Weaver</description>

    <dependencies>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-grpc-server</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-amqp</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-redis-configuration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-redis-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-postgres-persistence</artifactId>
        </dependency>

        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-es8-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-os-persistence-v3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-redis-lock</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-redis-concurrency-limit</artifactId>
        </dependency>

        <!-- Tasks -->
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-database-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-http-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-json-jq-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-respond-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-redis-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-scripting-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-secrets</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-rule-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-ai</artifactId>
        </dependency>

        <!-- Schedulers -->
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-scheduler-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-scheduler-postgres-persistence</artifactId>
        </dependency>

        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-scheduler-redis-persistence</artifactId>
        </dependency>


        <!-- Listeners -->
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-workflow-event-listener</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>weaver-task-status-listener</artifactId>
        </dependency>

        <!-- Audit -->
        <dependency>
            <groupId>com.vodafone.vss.weaver</groupId>
            <artifactId>audit</artifactId>
        </dependency>

        <!-- Framework & Metrics -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-cloudwatch2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-azure-monitor</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-web</artifactId>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.orkes.queues</groupId>
            <artifactId>orkes-conductor-queues</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-to-slf4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.vodafone.vss.weaver.Weaver</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
