<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <Property name="LOG_DIR">../logs</Property>

        <Property name="LOG_PATTERN">%d{ISO8601} [%-5level] [%t]%notEmpty{ requestId(%X{RID})}%notEmpty{ correlationId(%X{correlationId})} %c - %msg%notEmpty{ %throwable}%n</Property>
    </Properties>

    <Appenders>

        <!-- Console Logger -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    disableAnsi="false"
                    noConsoleNoAnsi="false"
                    pattern="%highlight{${LOG_PATTERN}}{FATAL=red bold, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan, TRACE=blue}"/>
        </Console>

        <!-- Rolling File Logger (Plain Text) -->
        <RollingFile name="FileLog"
                     fileName="${LOG_DIR}/app.log"
                     filePattern="${LOG_DIR}/app-%d{yyyy-MM-dd}-%i.log.gz">

            <PatternLayout pattern="${LOG_PATTERN}"/>

            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>

            <DefaultRolloverStrategy max="20"/>
        </RollingFile>

    </Appenders>

    <Loggers>
        <!-- Third-party Loggers -->
        <Logger name="org.springframework" level="error" additivity="false">
            <AppenderRef ref="FileLog"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="org.hibernate" level="error" additivity="false">
            <AppenderRef ref="FileLog"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="com.zaxxer.hikari" level="error" additivity="false">
            <AppenderRef ref="FileLog"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Weaver Application Logger -->
        <Logger name="com.vodafone.vss.weaver" level="info" additivity="false">
            <AppenderRef ref="FileLog"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="FileLog"/>
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>